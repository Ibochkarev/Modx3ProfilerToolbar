```

### vite.mgr.config.js

```javascript
export default defineConfig({
  root: mgrRoot,
  build: {
    rollupOptions: {
      external: (id) =>
        id === 'vue' ||
        id.startsWith('vue/') ||
        id === 'pinia' ||
        id.startsWith('pinia/') ||
        id === 'primevue' ||
        id.startsWith('primevue/') ||
        id.startsWith('@primevue/') ||
        id.startsWith('@vuetools/'),
    },
  },
  css: {
    postcss: {
      plugins: [
        prefixSelector({
          prefix: '.vueApp',
          exclude: [/^:root/, /^\.p-/, /^\.pi/, /^\[data-p-/],
        }),
      ],
    },
  },
})
```

